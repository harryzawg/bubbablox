 local p = Instance.new(&quot;Message&quot;)
 p.Text = &quot;&quot;
 p.Parent = game.Workspace
 if h~=nil then 
  script.Parent.Parent.Parent = h.Parent
  script:remove()
 end
end

script.Parent.Touched:connect(onTouched)

</ProtectedString>
