			<Item class="Script" referent="RBX2433">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(hit)

if hit.Parent ~= nil then
	local players = game.Players:getChildren()
	for i = 1, #players do
		if players[i].Character ~= nil and players[i]:findFirstChild(&quot;LapValue&quot;) ~= nil then
		if players[i].Character:IsAncestorOf(hit) then
			if players[i].LapValue.Value == 1 and players[i].leaderstats:findFirstChild(&quot;Laps&quot;) ~= nil then
				players[i].leaderstats.Laps.Value = players[i].leaderstats.Laps.Value + 1
			end
			players[i].LapValue.Value = 0
		end
		end
	end
end

end

