					<Item class="Script" referent="RBX362">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Engine wreck</string>
							<ProtectedString name="Source">function onTouched(hit)if hit.Name == &quot;bodypart&quot; thenscript.Parent.Smoke.Enabled = true
script.Parent.Fire.Enabled = truescript.Parent.Parent.VehicleSeat.MaxSpeed = 0
wait(1)
script.Parent.Fire.Size = 8
wait(1)
script.Parent.Fire.Size = 9
wait(1)
script.Parent.Fire.Size = 10
wait(1)
message = Instance.new(&quot;Explosion&quot;)
message.Position = script.Parent.Parent.engine.Position
message.Parent = game.Workspace
message.BlastPressure = 50000
wait(1)
local Human = script.Parent.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;) 
if Human ~= nil then
Human.Health = 0


end
end
end
connection = script.Parent.Parent.Belt.Touched:connect(onTouched)
</ProtectedString>
