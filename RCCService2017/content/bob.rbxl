			<Item class="Script" referent="RBX2194">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(hit)

if hit.Parent ~= nil then
	local players = game.Players:getChildren()
	for i = 1, #players do
		if players[i].Character ~= nil and players[i]:findFirstChild(&quot;LapValue&quot;) ~= nil then
			if players[i].Character:IsAncestorOf(hit) then
				if players[i].LapValue.Value == 0 then players[i].LapValue.Value = 2 end
			end
		end
	end
end

end

script.Parent.Touched:connect(onTouched)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="Part" referent="RBX2195">
			<Properties>
