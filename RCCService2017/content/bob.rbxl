					<ProtectedString name="Source">object = script.Parent  --Put this script directly INSIDE the model you want to regenerate
if (object ~= nil) and (object ~= game.Workspace) then 
model = object 

backup = model:clone()  
waitTime = 600  --Time in seconds to wait between regenerations 
wait(math.random(0, waitTime)) 
while true do 
wait(waitTime) 

model:remove() 

wait(0) 

model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
message.Parent = nil 
end 
end 
</ProtectedString>
